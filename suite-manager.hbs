<div class="axs-wrap">
  <header class="axs-header">
    <p class="axs-intro">{{localize "AXETS.Intro"}}</p>
    <div class="axs-links">
      <a href="{{links.wiki}}" target="_blank" rel="noopener"><i class="fa-solid fa-book"></i> {{localize "AXETS.Links.Wiki"}}</a>
      <a href="{{links.discord}}" target="_blank" rel="noopener"><i class="fa-brands fa-discord"></i> {{localize "AXETS.Links.Discord"}}</a>
      <a href="{{links.patreon}}" target="_blank" rel="noopener"><i class="fa-brands fa-patreon"></i> {{localize "AXETS.Links.Patreon"}}</a>
    </div>
  </header>

  <div class="axs-table-wrap">
    <table class="axs-table">
      <thead>
        <tr>
          <th class="axs-col-toggle">{{localize "AXETS.Col.Enabled"}}</th>
          <th>{{localize "AXETS.Col.Module"}}</th>
          <th>{{localize "AXETS.Col.Installed"}}</th>
          <th>{{localize "AXETS.Col.Latest"}}</th>
          <th>{{localize "AXETS.Col.Status"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr class="axs-row axs-{{status}}{{#if changed}} axs-changed{{/if}}">
          <td class="axs-col-toggle">
            {{#if canToggle}}
              <input type="checkbox" data-action="toggle" data-module-id="{{id}}" {{checked active}}>
            {{else if isHub}}
              <i class="fa-solid fa-lock" data-tooltip="{{localize 'AXETS.HubLocked'}}"></i>
            {{else}}
              <span class="axs-dash">—</span>
            {{/if}}
          </td>
          <td>
            <div class="axs-title">{{title}}</div>
            {{#if reason}}<div class="axs-reason">{{reason}}</div>{{/if}}
          </td>
          <td>{{#if installedVersion}}{{installedVersion}}{{else}}<span class="axs-dash">—</span>{{/if}}</td>
          <td>{{#if latestVersion}}{{latestVersion}}{{else}}<span class="axs-dash">—</span>{{/if}}</td>
          <td class="axs-status"><i class="{{statusIcon}}"></i> {{statusLabel}}</td>
          <td class="axs-actions">
            {{#if changelog}}
              <a href="{{changelog}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AXETS.Changelog'}}"><i class="fa-solid fa-file-lines"></i></a>
            {{/if}}
            {{#if showManifest}}
              <button type="button" data-action="copy" data-manifest="{{manifest}}" data-tooltip="{{localize 'AXETS.CopyManifest'}}"><i class="fa-solid fa-copy"></i></button>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <p class="axs-note"><i class="fa-solid fa-circle-info"></i> {{localize "AXETS.UpdateNote"}}</p>
  <p class="axs-note"><i class="fa-solid fa-code-branch"></i> {{foundryLine}}</p>

  <footer class="axs-footer">
    <span class="axs-last">
      {{#if lastChecked}}{{localize "AXETS.LastChecked"}} {{lastChecked}}{{else}}{{localize "AXETS.NeverChecked"}}{{/if}}
    </span>
    <button type="button" data-action="check" {{#if checking}}disabled{{/if}}>
      <i class="fa-solid {{#if checking}}fa-spinner fa-spin{{else}}fa-rotate{{/if}}"></i> {{localize "AXETS.Check"}}
    </button>
    <button type="button" data-action="apply" {{#unless hasChanges}}disabled{{/unless}}>
      <i class="fa-solid fa-floppy-disk"></i> {{localize "AXETS.Apply"}}
    </button>
  </footer>
</div>
